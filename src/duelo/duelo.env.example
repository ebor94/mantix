# Módulo Duelo (la conexión reutiliza DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME de Mantix)
# Obligatorias
DUELO_PANEL_USUARIO=
DUELO_PANEL_CLAVE=
DUELO_JWT_SECRET=
DUELO_VERSION_POLITICA=borrador
# Opcionales
DUELO_INSCRIPCIONES_ABIERTAS=true
DUELO_ORIGENES=https://losolivoscucuta.com
# Carpeta de fotos; debe quedar FUERA de uploads/ (por defecto <backend>/datos/duelo/fotos).
# Una ruta relativa se toma desde la raíz del backend. Dentro de uploads/ el módulo responde 503.
DUELO_FOTOS_PATH=
# Contacto que aparece en el mensaje de cédula repetida. Definirla ANTES del lanzamiento:
# el valor por defecto es un marcador.
DUELO_CONTACTO=
# Correo de confirmación: n8n | ninguno
DUELO_CORREO_CANAL=ninguno
DUELO_N8N_WEBHOOK_URL=
DUELO_N8N_SECRETO=
# Cupo del evento: número máximo de inscripciones. Vacío = sin límite. Debe ser un entero positivo;
# cualquier otro valor (0, negativo, texto, decimal) deja el módulo en 503 para que un error no abra el cupo.
# Las inscripciones de prueba cuentan: bórralas antes del lanzamiento.
DUELO_CUPO_MAXIMO=
# Envíos por IP cada 15 minutos, antiabuso; NO es el cupo del evento (ese es DUELO_CUPO_MAXIMO)
DUELO_LIMITE_INSCRIPCIONES=30
# Cloudflare Turnstile (si está vacío no se exige)
DUELO_TURNSTILE_SECRET=
