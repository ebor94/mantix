# Módulo Duelo (la conexión reutiliza DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME de Mantix)
# Obligatorias
DUELO_PANEL_USUARIO=
DUELO_PANEL_CLAVE=
DUELO_JWT_SECRET=
DUELO_VERSION_POLITICA=borrador
# Opcionales
DUELO_INSCRIPCIONES_ABIERTAS=true
DUELO_ORIGENES=https://losolivoscucuta.com
# Carpeta de fotos; debe quedar FUERA de uploads/ (por defecto <backend>/datos/duelo/fotos)
DUELO_FOTOS_PATH=
# Contacto que aparece en el mensaje de cédula repetida
DUELO_CONTACTO=
# Correo de confirmación: n8n | ninguno
DUELO_CORREO_CANAL=ninguno
DUELO_N8N_WEBHOOK_URL=
DUELO_N8N_SECRETO=
# Envíos por IP cada 15 minutos
DUELO_LIMITE_INSCRIPCIONES=30
# Cloudflare Turnstile (si está vacío no se exige)
DUELO_TURNSTILE_SECRET=
