# Módulo Agenda de Masajes (la conexión reutiliza DB_HOST, DB_PORT y DB_NAME de Mantix)
# Sin valores reales en este archivo. Si falta o es inválida una variable obligatoria, /api/masajes/v1
# responde 503 y el resto de Mantix sigue funcionando; el motivo queda en el log.

# --- Obligatorias ---
MASAJES_JWT_SECRET=           # ≥ 32 caracteres (openssl rand -base64 48), distinto de JWT_SECRET,
                              # IDENTIDAD_JWT_SECRET, TRK_JWT_SECRET y PORTERIA_JWT_SECRET
MSJ_GRUPO_ADMIN_DN=           # DN COMPLETO del grupo admin, p. ej. CN=GG-Masajes-Admin,OU=Grupos,DC=olivos,DC=local

# --- Recomendadas ---
MSJ_DB_USER=                  # usuario de mínimo privilegio (docs/masajes/permisos-bd.sql); si falta se usa DB_USER
MSJ_DB_PASSWORD=
MASAJES_JWT_EXPIRES=8h        # minutos u horas (30m, 8h)
MASAJES_JWT_EXPIRES_ADMIN=2h  # el rol admin se toma del AD al iniciar sesión: vigencia corta

# --- Reglas de la agenda (opcionales; estos son los valores por defecto) ---
MSJ_FRANJAS=08:00,09:00,10:00,11:00,14:00,15:00,16:00,17:00
MSJ_DURACION_MIN=60
MSJ_ANTICIPACION_AGENDAR_H=24
MSJ_ANTICIPACION_MODIFICAR_H=24
MSJ_DOMINIOS_AUTOVINCULO=losolivos.co
MSJ_CAMBIOS_DIARIOS=4         # reprogramaciones + cancelaciones del empleado en 24 h (el admin no tiene tope)
MSJ_APP_URL=https://mantix.losolivos.co/masajes

# --- Integraciones (las exige el worker del outbox; sin ellas no se envía nada) ---
MSJ_JOBS_ENABLED=false        # true en UNA sola instancia de pm2
MSJ_SPA_NOMBRE=
MSJ_SPA_EMAIL=
MSJ_SPA_DIRECCION=
MSJ_SPA_EN_EVENTO=false
# Correo y calendario por n8n (flujo "Masajes — avisos", docs/masajes/n8n-avisos.json). Con estas dos, las
# MSJ_GOOGLE_* no hacen falta y el correo sale por la cuenta de Gmail del flujo, no por el SMTP de Mantix.
MSJ_N8N_WEBHOOK_URL=          # p. ej. http://192.9.17.10:5678/webhook/masajes-avisos
MSJ_N8N_SECRETO=              # ≥ 32 caracteres (openssl rand -hex 32); el mismo valor de la credencial Header Auth
# --- Sin n8n: Google directo con cuenta de servicio ---
MSJ_GOOGLE_CALENDAR_ID=
MSJ_GOOGLE_IMPERSONAR=        # cuenta de agenda, p. ej. agenda.bienestar@losolivos.co
MSJ_GOOGLE_SA_JSON=           # ruta ABSOLUTA fuera del repo, permisos 600; DWD solo con scope calendar.events
MSJ_HABLAME_URL=              # https obligatorio
MSJ_HABLAME_CUENTA=
MSJ_HABLAME_API_KEY=
MSJ_HABLAME_TOKEN=
MSJ_SMS_TOPE_DIARIO=100

# El login reutiliza la conexión al AD de H360: LDAP_URL, LDAP_BASE_DN, LDAP_BIND_USER y LDAP_BIND_PASS son
# OBLIGATORIAS (sin ellas el módulo responde 503).
# El origen del front (p. ej. https://apps.losolivoscucuta.com) debe estar en CORS_ORIGIN de Mantix: si no, el
# navegador bloquea el login y Mantix responde 500.
