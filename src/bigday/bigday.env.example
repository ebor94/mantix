# Variables del módulo October Big Day (encuesta). Copiarlas al .env de Mantix (el .env.example
# de la raíz está en .gitignore). Si falta alguna obligatoria (BIGDAY_HASH_SALT o la conexión a la base; BIGDAY_RESULTS_TOKEN es opcional), /api/bigday/v1/* responde 503
# y Mantix sigue funcionando.

# Base `serfuweb`. El módulo reutiliza las variables de Mantix DB_HOST, DB_PORT, DB_USER, DB_PASSWORD y
# DB_NAME (la DB_NAME de Mantix ES serfuweb), así que normalmente NO hace falta definir BIGDAY_DB_*:
# con las DB_* de Mantix solo se necesitan BIGDAY_HASH_SALT y BIGDAY_RESULTS_TOKEN.
# Cada BIGDAY_DB_* que se defina gana sobre su DB_* equivalente (puerto por defecto 3306, base por defecto
# serfuweb). Úsalas solo para conectar con un usuario separado de mínimo privilegio (INSERT, SELECT y
# UPDATE solo de la columna id sobre bigday_respuestas; el UPDATE (id) lo exige el
# `INSERT … ON DUPLICATE KEY UPDATE id = id`): ver src/bigday/migrations/003_usuario_minimo.sql
# Configuración actual de producción: la API usa el usuario DB_* de Mantix (sin BIGDAY_DB_*). Es una decisión
# del responsable (Edwin) y un riesgo aceptado frente a la spec §9 (usuario de mínimo privilegio): ese
# usuario tiene más permisos de los necesarios sobre serfuweb. Para cerrarlo, crear el usuario de la 003 y
# definir BIGDAY_DB_HOST/USER/PASSWORD.
# Si usas BIGDAY_DB_*, define BIGDAY_DB_HOST, BIGDAY_DB_USER y BIGDAY_DB_PASSWORD juntos (evita mezclar
# un usuario con la contraseña o el host de otro).
#BIGDAY_DB_HOST=
#BIGDAY_DB_PORT=3306
#BIGDAY_DB_USER=
#BIGDAY_DB_PASSWORD=
#BIGDAY_DB_NAME=serfuweb

# Migración: `npm run bigday:migrate` lee el .env con la misma resolución (BIGDAY_DB_* o, si faltan, DB_*)
# y aplica 001 y 002 sobre serfuweb (idempotentes; la 003 es manual). Esa conexión necesita un usuario con
# CREATE y CREATE VIEW sobre serfuweb: si solo tienes el usuario de mínimo privilegio, corre la migración
# con las DB_* de Mantix (o con BIGDAY_DB_* apuntando a un usuario con esos permisos).

# Sal para el hash SHA-256 de IP y user-agent (nunca se guardan en claro). Valor largo y aleatorio.
BIGDAY_HASH_SALT=

# Token para GET /api/bigday/v1/resultados y /resultados.csv (header Authorization: Bearer <token>).
# Obligatorio solo para los resultados: si falta, esas rutas responden 503 y la encuesta sigue recibiendo
# respuestas. Generar un valor largo y aleatorio, p. ej.:  openssl rand -hex 32
BIGDAY_RESULTS_TOKEN=

# CORS: Mantix usa su allowlist global CORS_ORIGIN (orígenes separados por coma).
# Si la encuesta NO se sirve por el mismo dominio que la API, añade su dominio, p. ej.:
# CORS_ORIGIN=https://losolivoscucuta.com,https://encuesta.ejemplo.org
