# Variables del módulo October Big Day (encuesta). Copiarlas al .env de Mantix (el .env.example
# de la raíz está en .gitignore). Si falta alguna obligatoria, /api/bigday/v1/* responde 503
# y Mantix sigue funcionando.

# Base `serfuweb` (pool mysql2 propio, distinto del Sequelize de Mantix). Usuario con solo INSERT/SELECT
# sobre bigday_respuestas: ver src/bigday/migrations/003_usuario_minimo.sql
BIGDAY_DB_HOST=
BIGDAY_DB_PORT=3306
BIGDAY_DB_USER=
BIGDAY_DB_PASSWORD=
BIGDAY_DB_NAME=serfuweb

# Sal para el hash SHA-256 de IP y user-agent (nunca se guardan en claro). Valor largo y aleatorio.
BIGDAY_HASH_SALT=

# CORS: Mantix usa su allowlist global CORS_ORIGIN (orígenes separados por coma).
# Si la encuesta NO se sirve por el mismo dominio que la API, añade su dominio, p. ej.:
# CORS_ORIGIN=https://losolivoscucuta.com,https://encuesta.ejemplo.org
